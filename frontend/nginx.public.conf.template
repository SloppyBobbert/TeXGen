worker_processes 1;
pid /tmp/nginx.pid;
error_log stderr warn;

events {
    worker_connections 512;
}

http {
    include /etc/nginx/mime.types;
    # PDF.js ships a module worker; the base MIME table omits this extension.
    types { application/javascript mjs; }
    default_type application/octet-stream;
    access_log off;
    server_tokens off;
    client_max_body_size 1m;
    client_body_timeout 10s;
    send_timeout 30s;
    client_body_temp_path /tmp/client_body;
    proxy_temp_path /tmp/proxy;
    fastcgi_temp_path /tmp/fastcgi;
    uwsgi_temp_path /tmp/uwsgi;
    scgi_temp_path /tmp/scgi;

    map $uri $asset_cache_control {
        default "no-store";
        ~^/assets/ "public, max-age=31536000, immutable";
    }

    # Validate the Host header independently of absolute-form request targets.
    map $http_host $public_request_host {
        default "";
        ~^([^:]+)(:[0-9]+)?$ $1;
    }

    upstream django {
        server unix:/run/texgen-web/app.sock;
    }

    # Health only: never publish this internal HTTP listener.
    server {
        listen 127.0.0.1:8080;
        server_name localhost;
        location = /healthz { return 200 "ok\n"; }
        location / { return 404; }
    }

    server {
        listen 8081 default_server;
        server_name ${TEXGEN_PUBLIC_HOST};
        if ($host != "${TEXGEN_PUBLIC_HOST}") { return 444; }
        if ($public_request_host != "${TEXGEN_PUBLIC_HOST}") { return 444; }
        return 308 https://${TEXGEN_PUBLIC_HOST}$request_uri;
    }

    server {
        listen 8443 ssl default_server;
        server_name ${TEXGEN_PUBLIC_HOST};
        ssl_certificate /run/texgen-tls/fullchain.pem;
        ssl_certificate_key /run/texgen-tls/privkey.pem;
        ssl_protocols TLSv1.2 TLSv1.3;
        if ($host != "${TEXGEN_PUBLIC_HOST}") { return 444; }
        if ($public_request_host != "${TEXGEN_PUBLIC_HOST}") { return 444; }
        root /usr/share/nginx/html;

        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        add_header Cache-Control $asset_cache_control;
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header X-Frame-Options;

        proxy_http_version 1.1;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
        proxy_send_timeout 15s;
        proxy_set_header Connection "";
        proxy_set_header Host $http_host;
        # Replace, rather than append to, untrusted client forwarding headers.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header X-Forwarded-Port "";
        proxy_set_header Forwarded "";

        location /api/ { proxy_pass http://django; }
        location /admin/ { proxy_pass http://django; }
        location /static/ { alias /srv/django-static/; }
        location /assets/ { try_files $uri =404; }
        location = /healthz { return 200 "ok\n"; }
        location ~ /\. { deny all; }
        location / { try_files $uri $uri/ /index.html; }
    }
}
